#!/bin/bash
# Sioyek for macOS (2.0 and 3-alpha alike) stores user config inside its app
# bundle. Keep the real files in ~/.config/sioyek and repair links only when
# relevant state changes.
# prefs-sha256: {{ include "dot_config/sioyek/prefs_user.config" | sha256sum }}
# keys-sha256: {{ include "dot_config/sioyek/keys_user.config" | sha256sum }}
# app-marker: {{ output "/bin/sh" "-c" "if [ -e /Applications/Sioyek.app ]; then /usr/bin/stat -f '%m:%i' /Applications/Sioyek.app; else echo absent; fi" | trim }}
set -euo pipefail
[[ "$(uname -s)" == "Darwin" ]] || exit 0

bundle_dir='/Applications/Sioyek.app/Contents/MacOS'
config_dir="$HOME/.config/sioyek"
[[ -d "$bundle_dir" ]] || exit 0

for name in prefs_user.config keys_user.config; do
  src="$config_dir/$name"
  dst="$bundle_dir/$name"
  [[ -e "$src" ]] || continue

  if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
    continue
  fi

  if [[ -e "$dst" || -L "$dst" ]]; then
    if [[ -f "$dst" && ! -s "$dst" ]]; then
      rm -f "$dst"
    else
      mv "$dst" "$dst.bak.$(date +%Y%m%d%H%M%S)"
      echo "backed up $dst"
    fi
  fi

  ln -s "$src" "$dst"
  echo "linked $dst -> $src"
done
