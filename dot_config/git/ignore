# dsh-agent-teams runtime state (per-member mailboxes, team records,
# retired-member ids). Host-plane state like session logs, not project
# source: it churns on every message and carries local paths and session
# ids, so keep it out of every repo at once rather than per-repo.
**/.agent-teams/

# DeepSeek Harness IM attachments and local analysis artifacts. DSH may create
# this cache in any workspace; uploads can contain private conversation data.
**/.dsh-im/

# archify skill 生成目录
.archify/

# Neovim internal-log fallback: when nvim cannot open its default log under
# ~/.local/state/nvim/ (e.g. headless nvim spawned inside the dsh file
# sandbox), it falls back to writing nvim.log in the cwd. Harmless runtime
# leftovers, never meant to be committed.
nvim.log
