# dsh-tui 的个人覆盖层，在 bundle 之后应用。
# 保留个人路由、认证分工、搜索偏好、DeepSeek 输出预算和 Colemak 按键。
# Codex/Claude 由 dsh-tui-auth 管理；Copilot 和 API Key 路由由 llm-pi-ai 管理。
# providers 不得重叠；TUI auth 不挂载 xAI。
# config 是整体替换：修改 TUI 条目时须保留下方 bundle 的启动变量映射。

# 内置搜索固定走 DeepSeek Search API；网页抓取保留本地 HTTP。
- id: web
  config:
    searchProvider: deepseek-search-api
    fetchProvider: http

# TUI bundle 默认禁用内置 web 工具；只解禁，沿用其超时与抓取配置。
- id: tool-web
  disabled: false

# profile 级偏好对所有工作目录生效；保留 bundle 的 persona 环境变量入口。
# 这是模型选工具的指令，不是自动回退或重试机制。
- id: system-prompt
  config:
    personaPrefix: !!js process.env.DSH_TUI_PERSONA ?? 'You are a coding agent.'
    personaSuffix: |-
      联网搜索优先使用内置 web_search；该工具调用失败、不可用或结果不足时，
      再使用智谱搜索或 Firecrawl 等 MCP 工具。

- id: llm-pi-ai
  config:
    providers:
      # 沿用官方认证和内置目录，保留当前 live 的重试策略。
      github-copilot:
        retryPolicy:
          mode: normal
          maxRetries: 5
          retryableCodes:
            - EMPTY_RESPONSE
            - RATE_LIMIT
            - SERVER
            - TIMEOUT
            - TRANSPORT
            - STREAM_CLOSED
      # 智谱使用内置模型目录，仅指定凭据引用。
      zai-coding-cn:
        apiKeyEnv: ZAI_CODING_CN_API_KEY
      # traex_bridge：本机 Trae→OpenAI 网关（127.0.0.1:8317，openai-responses），
      # pi-ai 目录没有这些模型，整段手写；maxTokens 显式声明防 32768 截断。
      traex:
        apiKeyEnv: TRAEX_BRIDGE_API_KEY
        displayName: TraeX Bridge
        api: openai-responses
        baseURL: http://127.0.0.1:8317/v1
        compat:
          supportsDeveloperRole: true
          supportsMaxOutputTokens: true
        models:
          - id: GPT-5.6-Sol
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-5.6-Sol[1m]"
            contextWindow: 800000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: GPT-6-Astra
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-6-Astra[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: openrouter-3o
            contextWindow: 200000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: "openrouter-3o[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: "GPT-6.1-Sol"
            contextWindow: 475000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-6.1-Sol[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "openrouter-4o"
            contextWindow: 200000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: "openrouter-4o[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max

# 保留个人输出预算；认证、端点和 thinking 使用适配器默认值。
# 不设置 reasoningEffort：未显式选择强度时跟随当前模型默认值。
- id: llm-deepseek
  config:
    maxTokens: 393216

# 只覆盖个人按键；全屏/图片使用 schema 默认值，不固定模型或推理强度。
# config 整体替换会覆盖 bundle，必须显式保留其启动参数到环境变量的映射。
- id: dsh-tui
  config:
    preset: !!js process.env.DSH_TUI_PRESET ?? undefined
    workspace: !!js process.env.DSH_TUI_WORKSPACE_TARGET ?? undefined
    sessionId: !!js process.env.DSH_TUI_RESUME_SESSION ?? undefined
    backend: !!js process.env.DSH_TUI_BACKEND || undefined
    vimKeys:
      left: n
      down: e
      up: u
      right: i
      wordEnd: h
      undo: l
      insert: k
      insertFirstNonBlank: K
      lineStart: N
      lineEnd: I

# 显式限定订阅路由，避免默认挂载 xAI 或与官方路由重叠。
- id: dsh-tui-auth
  disabled: false
  config:
    providers:
      - openai-codex
      - anthropic
    modelOverrides:
      openai-codex:
        gpt-5.6-sol:
          contextWindow: 512000
          maxTokens: 128000

- insert:
    - id: mcp-firecrawl
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: firecrawl
        transport: stdio
        # 绝对路径：GUI/launchd 拉起的 dsh（com.dsh.doctor）PATH 里没有 fnm，裸 npx spawn 失败
        command: {{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npx
        args:
          - -y
          - firecrawl-mcp@3.24.0
        env:
          FIRECRAWL_API_URL: http://127.0.0.1:3002
          NPM_CONFIG_CACHE: !!js process.env.HOME + '/.cache/dsh-npm'
          # 默认 registry 未同步该包（3.24.0 起长期缺失），此 npx 子进程单独走公共 npm
          NPM_CONFIG_REGISTRY: https://registry.npmjs.org
        toolCallTimeoutMs: 180000
        failOnStartupError: false

# ===== GLM Coding Plan (智谱) 官方 MCP =====
# API Key 统一读环境变量 ZAI_CODING_CN_API_KEY（~/.config/secrets/api-keys.env 导出，
# ~/.zshenv 引导 source，仅覆盖 shell 进程；GUI/launchd 进程读不到该变量时
# tools/list 健康检查会拿应用层 401，GUI 域注入方案待定）。
# 联网搜索 / 网页读取 / 开源仓库均使用远程 streamable-http。
# ⚠️ 新增插件实例必须挂在 insert 列表里：顶层 `- id:` 是按 id 定位已有条目的 patch，
# id 在组合树里不存在时整条被静默丢弃（--dump-config 仅一行 "entry not found" 警告，
# GLM server 曾经因此从未加载）。
- insert:
    - id: mcp-zai-search
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-search-prime
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-reader
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-reader
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_reader/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-zread
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: zread
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/zread/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false
