# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
#
# openai-codex lives here (entry config) instead of $DSH_HOME/settings.yaml:
# the TUI's dsh-auth plugin owns that route at boot, so declaring it in the
# shared settings section made llm-pi-ai's all-or-nothing registration fail
# there (zai-coding-cn never registered). This profile has no dsh-auth, so
# the entry-level route merges with the settings section per provider.
- id: llm-pi-ai
  config:
    providers:
      openai-codex: {}

# dsh-at-file / dsh-fetch-file 截至 0.6.3 / 0.1.2 未适配 dsh 0.1.2-rc.1
# 的官方包导出面（dsh-settings 的 settingsNamespace、dsh-llm 的 CallId 被移除），
# import 即炸、拖垮整棵插件树。等上游发适配版后删除这两行解禁。
- id: dsh-at-file
  disabled: true
- id: download
  disabled: true

# dsh-agent-teams 0.1.16-rc.1 仅支持 Harness 0.1.2；在 0.1.5-rc.1 下
# 无法安装 retired-member guard，会使整个 web 插件树启动失败。
- id: agent-teams
  disabled: true

# dsh-web-all 0.3.20 bundles dsh-better-sidebar@0.19.0-alpha.1, while this
# profile directly loads the DSH 0.1.5-rc.1-compatible stable release. Keep the
# direct bundle first and disable the aggregate entry so only one plugin owns
# /sidebar/api.
- id: web-ui-better-sidebar
  disabled: true

- insert:
    - id: mcp-firecrawl
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: firecrawl
        transport: stdio
        # 绝对路径：GUI/launchd 拉起的 dsh（com.dsh.doctor）PATH 里没有 fnm，裸 npx spawn 失败
        command: {{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npx
        args:
          - -y
          - firecrawl-mcp@3.24.0
        env:
          FIRECRAWL_API_URL: http://127.0.0.1:3002
          NPM_CONFIG_CACHE: !!js process.env.HOME + '/.cache/dsh-npm'
        toolCallTimeoutMs: 180000
        failOnStartupError: false

# ===== GLM Coding Plan (智谱) 官方 MCP =====
# API Key 统一读环境变量 ZAI_CODING_CN_API_KEY（~/.config/secrets/api-keys.env 导出，
# ~/.zshenv 引导 source，仅覆盖 shell 进程；GUI/launchd 进程读不到该变量时
# tools/list 健康检查会拿应用层 401，GUI 域注入方案待定）。
# 联网搜索 / 网页读取 / 开源仓库均使用远程 streamable-http。
# ⚠️ 新增插件实例必须挂在 insert 列表里：顶层 `- id:` 是按 id 定位已有条目的 patch，
# id 在组合树里不存在时整条被静默丢弃（--dump-config 仅一行 "entry not found" 警告，
# GLM server 曾经因此从未加载）。
- insert:
    - id: mcp-zai-search
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-search-prime
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-reader
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-reader
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_reader/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-zread
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: zread
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/zread/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false
- id: dsh-annotation
  disabled: true
