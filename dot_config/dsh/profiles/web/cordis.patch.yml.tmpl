# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
#
# openai-codex lives here (entry config) instead of $DSH_HOME/settings.yaml:
# the TUI's dsh-auth plugin owns that route at boot, so declaring it in the
# shared settings section made llm-pi-ai's all-or-nothing registration fail
# there (zai-coding-cn never registered). This profile has no dsh-auth, so
# the entry-level route merges with the settings section per provider.
#
# 2026-09-28 起 zai-coding-cn / traex 也常驻 entry 层（同 settings.yaml 分节等值）：
# 桌面版 0.1.7-rc.2 的 settings 导入器在每次 boot/config-reload 时都会把
# $DSH_HOME/settings.yaml 无条件改名成 .imported 并只按它的 entry 体系吸收，
# legacy 文件随时会消失；entry 层是本 profile 自己的 patch，不受影响。
# settings 分节仍在时按 provider 合并（同值叠加，无冲突）。
- id: llm-pi-ai
  config:
    providers:
      openai-codex: {}
      # zai（GLM）：pi-ai 0.87.1 目录原生含 glm-5.3 系，只需 apiKeyEnv，不写 models
      #（手写 models 是整体替换，会丢目录附带的 compat 修正）。
      zai-coding-cn:
        apiKeyEnv: ZAI_CODING_CN_API_KEY
      # traex_bridge：本机 Trae→OpenAI 网关（127.0.0.1:8317，openai-responses 协议），
      # 复用 ~/.trae 授权。pi-ai 目录没有这些模型，必须整段手写；maxTokens 必须显式
      # 声明，否则落 harness 兜底 32768 长输出中途截断。
      traex:
        apiKeyEnv: TRAEX_BRIDGE_API_KEY
        displayName: TraeX Bridge
        api: openai-responses
        baseURL: http://127.0.0.1:8317/v1
        compat:
          supportsDeveloperRole: true
          supportsMaxOutputTokens: true
        models:
          - id: GPT-5.6-Sol
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-5.6-Sol[1m]"
            contextWindow: 800000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: GPT-6-Astra
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-6-Astra[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: openrouter-3o
            contextWindow: 200000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: "openrouter-3o[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max

# 同上（entry 层兜底）：deepseek 官方路由只抬输出上限（384K=393216，API 实测），
# 不写 models（内置目录已含 deepseek-flash）。
- id: llm-deepseek
  config:
    maxTokens: 393216

# entry 层默认模型兜底（settings.yaml 被桌面版吃掉时的 floor；
# picker 运行时写 settings 分节，存在时仍以 settings 为准）。
- id: agent-default-model
  config:
    provider: deepseek-official
    model: deepseek-flash
    reasoningEffort: high

# dsh-at-file / dsh-fetch-file 截至 0.6.3 / 0.1.2 未适配 dsh 0.1.2-rc.1
# 的官方包导出面（dsh-settings 的 settingsNamespace、dsh-llm 的 CallId 被移除），
# import 即炸、拖垮整棵插件树。等上游发适配版后删除这两行解禁。
- id: dsh-at-file
  disabled: true
- id: download
  disabled: true

# dsh-agent-teams 0.1.16-rc.1 曾因仅支持 Harness 0.1.2、无法安装 retired-member
# guard 被禁用；2026-09-16 手改部署文件移除禁用，此处回填模板保持一致。

- insert:
    - id: mcp-firecrawl
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: firecrawl
        transport: stdio
        # 绝对路径：GUI/launchd 拉起的 dsh（com.dsh.doctor）PATH 里没有 fnm，裸 npx spawn 失败
        command: {{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npx
        args:
          - -y
          - firecrawl-mcp@3.24.0
        env:
          FIRECRAWL_API_URL: http://127.0.0.1:3002
          NPM_CONFIG_CACHE: !!js process.env.HOME + '/.cache/dsh-npm'
          # 默认 registry 未同步该包（3.24.0 起长期缺失），此 npx 子进程单独走公共 npm
          NPM_CONFIG_REGISTRY: https://registry.npmjs.org
        toolCallTimeoutMs: 180000
        failOnStartupError: false

# ===== GLM Coding Plan (智谱) 官方 MCP =====
# API Key 统一读环境变量 ZAI_CODING_CN_API_KEY（~/.config/secrets/api-keys.env 导出，
# ~/.zshenv 引导 source，仅覆盖 shell 进程；GUI/launchd 进程读不到该变量时
# tools/list 健康检查会拿应用层 401，GUI 域注入方案待定）。
# 联网搜索 / 网页读取 / 开源仓库均使用远程 streamable-http。
# ⚠️ 新增插件实例必须挂在 insert 列表里：顶层 `- id:` 是按 id 定位已有条目的 patch，
# id 在组合树里不存在时整条被静默丢弃（--dump-config 仅一行 "entry not found" 警告，
# GLM server 曾经因此从未加载）。
- insert:
    - id: mcp-zai-search
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-search-prime
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-reader
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-reader
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_reader/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-zread
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: zread
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/zread/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false
- id: dsh-annotation
  disabled: true

# 2026-09-28 从 live cordis.patch.yml 回填：dshmarket 运行时写入的禁用。
# （组合树里尚无 modlens 条目，dump 会报 entry not found，属无害死配置。）
- id: modlens
  disabled: true
