# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
#
# 2026-09-28 LLM 路由 entry 层兜底：桌面版 0.1.7-rc.2 的 settings 导入器会在
# boot/config-reload 时无条件把 $DSH_HOME/settings.yaml 改名 .imported 吸收掉，
# legacy 分节随时消失，故 zai/traex 提供方与 deepseek 上限常驻本 patch 层。
# ⚠️ 不在此声明 openai-codex：TUI 的 dsh-auth 拥有该路由，settings 分节曾因
# 与其冲突触发 llm-pi-ai 整段注册失败（zai 连带消失）。zai/traex 不归 dsh-auth 管。
# patch 的 config 是整体替换：以下条目均含从 0.10.2 dump 抄回的 base 字段，
# 升级 TUI bundle 时须重新对照 --dump-config。
- id: llm-pi-ai
  config:
    providers:
      # zai（GLM）：pi-ai 0.87.1 目录原生含 glm-5.3 系，只写 apiKeyEnv，不写 models。
      zai-coding-cn:
        apiKeyEnv: ZAI_CODING_CN_API_KEY
      # traex_bridge：本机 Trae→OpenAI 网关（127.0.0.1:8317，openai-responses），
      # pi-ai 目录没有这些模型，整段手写；maxTokens 显式声明防 32768 截断。
      traex:
        apiKeyEnv: TRAEX_BRIDGE_API_KEY
        displayName: TraeX Bridge
        api: openai-responses
        baseURL: http://127.0.0.1:8317/v1
        compat:
          supportsDeveloperRole: true
          supportsMaxOutputTokens: true
        models:
          - id: GPT-5.6-Sol
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-5.6-Sol[1m]"
            contextWindow: 800000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: GPT-6-Astra
            contextWindow: 272000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: "GPT-6-Astra[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: openrouter-3o
            contextWindow: 200000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max
          - id: "openrouter-3o[1m]"
            contextWindow: 1000000
            maxTokens: 65536
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max

# base（apiKeyEnv/baseURL/thinking/reasoningEffort）由 dsh-tui bundle 设置，整体替换须带上；
# maxTokens 抬到官方上限 384K=393216。（reasoningEffort: max 是 bundle base 的原始值，
# 0.10.2 与 0.11.2 tarball 的 cordis.patch.yml 均实测；此前漏抄，2026-09-29 补回。）
- id: llm-deepseek
  config:
    apiKeyEnv: DEEPSEEK_API_KEY
    baseURL: !!js process.env.DEEPSEEK_BASE_URL
    thinking: enabled
    reasoningEffort: max
    maxTokens: 393216

# entry 层默认模型兜底（settings.yaml 被桌面版吃掉时的 floor）。
- id: agent-default-model
  config:
    provider: deepseek-official
    model: deepseek-flash
    reasoningEffort: high

# base（provider/fullscreen/terminalImages/effort）从 0.10.2 dump 抄回，整体替换须带上；
# vimKeys 原经 settings dsh-tui 分节生效（colemak，机制由 profiles/dsh-tui/patches/
# 的本地 pnpm patch 提供），迁入 entry 层防 settings 文件消失。
- id: dsh-tui
  config:
    provider: deepseek-official
    fullscreen: true
    terminalImages: true
    effort: max
    vimKeys:
      left: n
      down: e
      up: u
      right: i
      wordEnd: h
      undo: l
      insert: k
      insertFirstNonBlank: K
      lineStart: N
      lineEnd: I

- id: dsh-tui-auth
  config:
    providers:
      - openai-codex
      - anthropic
      - xai
    modelOverrides:
      openai-codex:
        gpt-5.6-sol:
          contextWindow: 512000
          maxTokens: 128000

- insert:
    - id: mcp-firecrawl
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: firecrawl
        transport: stdio
        # 绝对路径：GUI/launchd 拉起的 dsh（com.dsh.doctor）PATH 里没有 fnm，裸 npx spawn 失败
        command: {{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npx
        args:
          - -y
          - firecrawl-mcp@3.24.0
        env:
          FIRECRAWL_API_URL: http://127.0.0.1:3002
          NPM_CONFIG_CACHE: !!js process.env.HOME + '/.cache/dsh-npm'
          # 默认 registry 未同步该包（3.24.0 起长期缺失），此 npx 子进程单独走公共 npm
          NPM_CONFIG_REGISTRY: https://registry.npmjs.org
        toolCallTimeoutMs: 180000
        failOnStartupError: false

# ===== GLM Coding Plan (智谱) 官方 MCP =====
# API Key 统一读环境变量 ZAI_CODING_CN_API_KEY（~/.config/secrets/api-keys.env 导出，
# ~/.zshenv 引导 source，仅覆盖 shell 进程；GUI/launchd 进程读不到该变量时
# tools/list 健康检查会拿应用层 401，GUI 域注入方案待定）。
# 联网搜索 / 网页读取 / 开源仓库均使用远程 streamable-http。
# ⚠️ 新增插件实例必须挂在 insert 列表里：顶层 `- id:` 是按 id 定位已有条目的 patch，
# id 在组合树里不存在时整条被静默丢弃（--dump-config 仅一行 "entry not found" 警告，
# GLM server 曾经因此从未加载）。
- insert:
    - id: mcp-zai-search
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-search-prime
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-reader
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: web-reader
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/web_reader/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false

    - id: mcp-zai-zread
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: zread
        transport: streamable-http
        url: https://open.bigmodel.cn/api/mcp/zread/mcp
        headers:
          Authorization: !!js "'Bearer ' + (process.env.ZAI_CODING_CN_API_KEY || '')"
        toolCallTimeoutMs: 180000
        failOnStartupError: false
