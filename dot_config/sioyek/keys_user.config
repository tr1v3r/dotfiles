# Sioyek user bindings. Defaults remain available; these add a Colemak layer.
# n/e/u/i = left/down/up/right, matching Neovim and Herdr.

move_left n
move_down e
move_up u
move_right i
move_left <left>
move_down <down>
move_up <up>
move_right <right>

# Uppercase NEIU keeps the direction layout but moves by reading-sized jumps.
goto_left_smart N
screen_down E
screen_up U
goto_right_smart I

screen_down <C-e>
screen_up <C-u>
prev_state [
next_state ]

# Display/view controls use a mnemonic z-prefix instead of the function row.
toggle_highlight zh
toggle_synctex zs
toggle_presentation_mode zt
toggle_mouse_drag_mode zm
toggle_visual_scroll zv
toggle_custom_color zc
fit_to_page_width zw
fit_to_page_width_smart zW
toggle_fullscreen zf
toggle_window_configuration zp

# Keep common Vim muscle memory explicit.
goto_beginning gg
goto_end G
search /
previous_item ,
next_item .
command :
quit q
