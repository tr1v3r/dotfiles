# Sioyek user preferences — Tokyo Night Night, technical-reading defaults.
# Sioyek 2.0.0 loads this through a symlink installed into its macOS app bundle.

use_legacy_keybinds 0
check_for_updates_on_startup 0
should_load_tutorial_when_no_other_file 0
should_launch_new_window 0

# Reading/navigation behavior.
move_screen_ratio 0.72
zoom_inc_factor 1.15
wheel_zoom_on_cursor 1
fit_to_page_width_ratio 0.86
touchpad_sensitivity 0.75
sort_bookmarks_by_location 1
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000
collapsed_toc 0
multiline_menus 1
rerender_overview 1
prerendered_page_count 3
case_sensitive_search 0
show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
show_close_portal_in_statusbar 1

# Tokyo Night chrome: the repo's #12131a blackened background with official foreground/selection colors.
background_color 0.071 0.075 0.102
dark_mode_background_color 0.071 0.075 0.102
dark_mode_contrast 0.85
ui_background_color 0.071 0.075 0.102
ui_text_color 0.753 0.792 0.961
ui_selected_background_color 0.157 0.204 0.341
ui_selected_text_color 0.753 0.792 0.961
status_bar_color 0.082 0.086 0.118
status_bar_text_color 0.663 0.694 0.839
status_bar_font_size 13
ui_font Hack Nerd Font Mono
font_size 15

# zc toggles a softer official #1a1b26 paper surface; it is not forced at startup.
custom_background_color 0.102 0.106 0.149
custom_text_color 0.753 0.792 0.961

# Tokyo Night search, link, SyncTeX, and reading-ruler accents.
text_highlight_color 0.878 0.686 0.408
search_highlight_color 0.620 0.808 0.416
link_highlight_color 0.478 0.635 0.969
synctex_highlight_color 0.733 0.604 0.969
visual_mark_color 0.478 0.635 0.969 0.18

# Semantic annotation palette: a=key point, b=definition, c=evidence, d=question, e=method/extension.
highlight_color_a 0.878 0.686 0.408
highlight_color_b 0.478 0.635 0.969
highlight_color_c 0.620 0.808 0.416
highlight_color_d 0.969 0.463 0.557
highlight_color_e 0.733 0.604 0.969
search_url_s https://scholar.google.com/scholar?q=
search_url_g https://www.google.com/search?q=
middle_click_search_engine s
shift_middle_click_search_engine g
