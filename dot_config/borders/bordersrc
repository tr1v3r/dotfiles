#!/bin/bash
# 焦点描边：细线 + Tokyo Night 蓝（#7aa2f7，与 kitty 的 cursor_trail_color 同色），只画焦点窗口。
# AeroSpace 不自带焦点提示，而 macOS 原生线索（交通灯/标题/阴影）在暗色贴边布局下很弱。
# 运行时调参：borders width=2.0（已跑实例会被后续调用更新，不必重启服务）。
options=(
  style=round
  width=1.5
  active_color=0xff7aa2f7
  inactive_color=0x00000000
)
borders "${options[@]}"
